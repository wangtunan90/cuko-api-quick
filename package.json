{
  "name": "cuko-api-quick",
  "version": "0.0.3",
  "description": "Stateful provider that controls Chrome via CDP to expose Amazon Quick (quick.aws.com) web chat as a Cuko-compatible API",
  "type": "module",
  "scripts": {
    "start": "node bridge/index.js",
    "test": "node test/run.mjs",
    "docs:index": "node scripts/build-docs-index.mjs",
    "build:exe": "node scripts/build-exe.mjs"
  },
  "dependencies": {
    "chrome-remote-interface": "^0.34.0"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
